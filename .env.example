KV_REST_API_URL=
KV_REST_API_TOKEN=

# PostHog project API key. Leave empty to disable analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=
# Points at the /ingest rewrite in next.config.mjs, not directly at PostHog.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# Set to 1 to capture from a dev build too. Off by default so local browsing
# does not pollute the production project.
NEXT_PUBLIC_POSTHOG_DEBUG=
